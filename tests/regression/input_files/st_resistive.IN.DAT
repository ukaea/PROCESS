alphaj   = 1.0 * Plasma current profile index (⍺ⱼ)
alphan   = 0.25 * Plasma density profile index (⍺ₙ)
alphat   = 0.5 * Plasma temperature profile index (⍺ₜ)
aspect   = 1.75 * Plasma aspect ratio (A) (`iteration variable 1`)
b_plasma_toroidal_on_axis = 3.0 * Plasma toroidal field on axis (Bᴛ(R₀)) [T] (`iteration variable 2`)
nd_plasma_electrons_vol_avg = 2.509129635340965e+19 * Plasma volume averaged electron density (⟨nₑ⟩) [/m³] (`iteration variable 6`)
